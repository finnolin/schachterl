# Public URL of the SvelteKit server. Used by the browser/Tauri client for API and auth requests.
PUBLIC_BASE_URL=http://localhost:5173

# Optional additional origin allowed for the Tauri development client.
# Leave empty unless your Tauri setup uses a custom origin.
PUBLIC_DEV_TAURI_ORIGIN=

# PostgreSQL connection used by the app and Drizzle.
DB_HOST=localhost
DB_PORT=5432
DB_USER=schachterl
DB_PASSWORD=change-me
DB_NAME=schachterl

# Optional PostgreSQL CA certificate. Leave empty for local Docker development.
DB_SSL_CA=

# Public PowerSync service URL returned to the client connector.
PUBLIC_POWERSYNC_URL=http://localhost:8080

# PowerSync JWT settings. The private key must match the public JWK in
# powersync/service.yaml and must never be committed or exposed to clients.
POWERSYNC_AUDIENCE=schachterl
POWERSYNC_JWT_KID=dev-key-1
POWERSYNC_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

# PowerSync service and database credentials used by docker-compose.yml.
POWERSYNC_PORT=8080
POWERSYNC_DB_PASSWORD=change-me-powersync
POWERSYNC_STORAGE_PASSWORD=change-me-powersync-storage
