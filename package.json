{
	"name": "schachterl",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"dev:tauri": "vite dev --port 5174",
		"build": "vite build",
		"build:tauri": "cross-env TAURI_BUILD=true BETTER_AUTH_SECRET=dummy-secret-for-build vite build",
		"build:native": "npm run remove:sql:wasm && vite build",
		"copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm static/assets",
		"remove:sql:wasm": "rimraf static/assets/sql-wasm.wasm",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"tauri": "tauri",
		"db:gen:local": "drizzle-kit generate --config=./src/lib/local/db/drizzle/config.ts",
		"db:gen:server": "drizzle-kit generate --config=./src/lib/server/db/drizzle/config.ts",
		"db:mig:server": "drizzle-kit migrate --config=./src/lib/server/db/drizzle/config.ts",
		"db:studio:server": "drizzle-kit studio --config=./src/lib/server/db/drizzle/config.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.2",
		"@tauri-apps/cli": "^2.9.6",
		"@types/node": "^22",
		"clsx": "^2.1.1",
		"copyfiles": "^2.4.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^16.5.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rimraf": "^6.1.2",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.3",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4"
	},
	"dependencies": {
		"@tauri-apps/plugin-sql": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.2",
		"better-auth": "^1.7.0-rc.1",
		"bits-ui": "^2.18.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"fractional-indexing": "^4.0.0",
		"fractional-indexing-jittered": "^1.0.0",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.8",
		"sqlocal": "^0.16.0",
		"uuid": "^13.0.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.27.2": true
	}
}
